# ClarifySQL Configuration

# Supabase PostgreSQL Connection
# Replace with your Supabase connection string:
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# LLM Provider: "ollama" (local testing) or "groq" (production)
LLM_PROVIDER=ollama

# Ollama Settings (for local testing on GPU machine, e.g., RTX 3070 8GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq Settings (production)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Query Execution Safety Sandbox
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=500
MAX_CORRECTION_RETRIES=2

# Semantic Layer Configuration (supports .yaml, .yml, or .json)
SEMANTIC_METRICS_PATH=config/metrics.yaml
